  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@board/ui": ["libs/ui/src/index.ts"],
      "@board/board-core": ["libs/board-core/src/index.ts"],
      "@board/api-client": ["libs/api-client/src/index.ts"]
    }
  }
}
